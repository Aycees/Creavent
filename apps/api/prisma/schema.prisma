// Tables are added when the first feature needs them (docs/development-plan.md §2).
// Names follow docs/data-model.md: snake_case tables and columns, camelCase in code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts and roles (data model §5.1) ──────────────────────────────────

enum RoleType {
  vendor
  organizer

  @@map("role_type")
}

enum ApprovalStatus {
  not_submitted
  pending_review
  approved
  rejected

  @@map("approval_status")
}

enum LegalDocument {
  terms
  privacy

  @@map("legal_document")
}

// Better Auth's user table, mapped onto ours. Better Auth owns id, fullName
// (its `name`), email, emailVerified, image, createdAt, and updatedAt.
model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.Citext
  emailVerified  Boolean   @default(false) @map("email_verified")
  fullName       String    @map("full_name")
  // Set by Better Auth from the Google profile. Not shown in the MVP: the
  // avatar people see is avatarFileId.
  image          String?
  phone          String?
  avatarFileId   String?   @map("avatar_file_id") @db.Uuid
  isAdmin        Boolean   @default(false) @map("is_admin")
  ageConfirmedAt DateTime? @map("age_confirmed_at") @db.Timestamptz
  lastLoginAt    DateTime? @map("last_login_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  avatarFile          File?               @relation("UserAvatar", fields: [avatarFileId], references: [id])
  sessions            Session[]
  accounts            Account[]
  legalAcceptances    LegalAcceptance[]
  roles               UserRole[]          @relation("UserRoles")
  reviewedRoles       UserRole[]          @relation("RoleReviewer")
  suspendedRoles      UserRole[]          @relation("RoleSuspender")
  uploadedFiles       File[]              @relation("FileUploader")
  vendorProfile       VendorProfile?
  organizerProfile    OrganizerProfile?
  emails              EmailNotification[]
  auditLogs           AuditLog[]
  moderatedEvents     Event[]             @relation("EventModerator")
  decidedApplications Application[]       @relation("ApplicationDecider")
  removedApplications Application[]       @relation("ApplicationRemover")
  assignedSlots       SlotAssignment[]    @relation("SlotAssigner")
  endedAssignments    SlotAssignment[]    @relation("AssignmentEnder")
  paymentsMade        Payment[]           @relation("PaymentPayer")
  paymentsReceived    Payment[]           @relation("PaymentPayee")
  paymentsDecided     Payment[]           @relation("PaymentDecider")

  @@map("users")
}

// Better Auth: one row per signed-in device.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Better Auth: how a user signs in. Replaces the data model's auth_identities.
// providerId is "credential" (email and password, with the hash in password)
// or "google" (accountId is the Google account ID).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  providerId            String    @map("provider_id")
  accountId             String    @map("account_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Better Auth: email verification and password reset tokens.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

// One row per sign-in try with a password, for the per-email lockout
// (architecture §4.1). Rows older than the lockout window are deleted.
model SignInAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@index([createdAt])
  @@map("sign_in_attempts")
}

// Never updated or deleted (data model §5.1).
model LegalAcceptance {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  document   LegalDocument
  version    String
  acceptedAt DateTime      @default(now()) @map("accepted_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, document])
  @@map("legal_acceptances")
}

model UserRole {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @map("user_id") @db.Uuid
  role                RoleType
  // Organizers only. Null for vendors.
  approvalStatus      ApprovalStatus? @map("approval_status")
  contactEmail        String?         @map("contact_email") @db.Citext
  approvalSubmittedAt DateTime?       @map("approval_submitted_at") @db.Timestamptz
  reviewedById        String?         @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?       @map("reviewed_at") @db.Timestamptz
  rejectionReason     String?         @map("rejection_reason")
  // The organizer's links when the admin last decided. Adding a link that
  // isn't here sends an approved organizer back to review (open question D9).
  reviewedLinks       Json?           @map("reviewed_links")
  adminNotes          String?         @map("admin_notes")
  suspendedAt         DateTime?       @map("suspended_at") @db.Timestamptz
  suspendedById       String?         @map("suspended_by") @db.Uuid
  suspensionReason    String?         @map("suspension_reason")
  // The last onboarding step completed for this role (1 to 4).
  onboardingStep      Int?            @map("onboarding_step")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user        User  @relation("UserRoles", fields: [userId], references: [id])
  reviewedBy  User? @relation("RoleReviewer", fields: [reviewedById], references: [id])
  suspendedBy User? @relation("RoleSuspender", fields: [suspendedById], references: [id])

  @@unique([userId, role])
  @@index([approvalStatus, approvalSubmittedAt])
  @@map("user_roles")
}

// ─── Files (data model §5.2) ───────────────────────────────────────────────

enum FilePurpose {
  payment_proof
  payment_qr
  application_document
  event_cover
  vendor_floor_plan
  public_floor_plan
  vendor_photo
  organizer_logo
  avatar

  @@map("file_purpose")
}

enum FileStatus {
  pending
  ready

  @@map("file_status")
}

model File {
  id          String      @id @default(uuid()) @db.Uuid
  uploadedBy  String      @map("uploaded_by") @db.Uuid
  purpose     FilePurpose
  status      FileStatus  @default(pending)
  // The final object: <purpose>/<id>.webp or <purpose>/<id>.pdf. Known at the
  // Ask step, because the declared type decides it and must match the real one.
  storageKey  String      @unique @map("storage_key")
  mimeType    String      @map("mime_type")
  sizeBytes   BigInt      @map("size_bytes")
  width       Int?
  height      Int?
  deleteAfter DateTime?   @map("delete_after") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  uploader             User                  @relation("FileUploader", fields: [uploadedBy], references: [id])
  avatarOf             User[]                @relation("UserAvatar")
  logoOf               OrganizerProfile[]
  vendorPhotos         VendorProfilePhoto[]
  coverOf              Event[]               @relation("EventCover")
  qrOf                 EventPaymentMethod[]
  vendorFloorPlanOf    Event[]               @relation("VendorFloorPlan")
  applicationDocuments ApplicationDocument[]
  publicFloorPlanOf    Event[]               @relation("PublicFloorPlan")

  @@index([uploadedBy, status])
  @@map("files")
}

// ─── Profiles and categories (data model §5.3) ─────────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  vendors              VendorProfileCategory[]
  events               EventCategory[]
  documentRequirements EventDocumentRequirement[]
  applications         ApplicationCategory[]

  @@map("categories")
}

model OrganizerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  displayName String   @map("display_name")
  slug        String?  @unique
  about       String?
  city        String?
  logoFileId  String?  @map("logo_file_id") @db.Uuid
  socialLinks Json     @default("[]") @map("social_links")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User    @relation(fields: [userId], references: [id])
  logoFile File?   @relation(fields: [logoFileId], references: [id])
  events   Event[]

  @@map("organizer_profiles")
}

model VendorProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  shopName    String   @map("shop_name")
  slug        String?  @unique
  description String?
  products    String?
  city        String?
  socialLinks Json     @default("[]") @map("social_links")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         User                    @relation(fields: [userId], references: [id])
  categories   VendorProfileCategory[]
  photos       VendorProfilePhoto[]
  applications Application[]
  assignments  SlotAssignment[]

  @@map("vendor_profiles")
}

model VendorProfileCategory {
  vendorProfileId String @map("vendor_profile_id") @db.Uuid
  categoryId      String @map("category_id") @db.Uuid

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id])

  @@id([vendorProfileId, categoryId])
  @@map("vendor_profile_categories")
}

model VendorProfilePhoto {
  id              String   @id @default(uuid()) @db.Uuid
  vendorProfileId String   @map("vendor_profile_id") @db.Uuid
  fileId          String   @map("file_id") @db.Uuid
  sortOrder       Int      @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  file          File          @relation(fields: [fileId], references: [id])

  @@map("vendor_profile_photos")
}

// ─── Events (data model §5.4) ──────────────────────────────────────────────

enum EventStatus {
  draft
  open_to_vendors
  announced
  completed
  canceled

  @@map("event_status")
}

enum ModerationState {
  visible
  hidden

  @@map("moderation_state")
}

// Reference data, inserted by a migration like categories. Never deleted,
// only made inactive.
model EventType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  events Event[]

  @@map("event_types")
}

// A draft may leave everything but the name and type empty. The "Open to
// vendors" checklist says what must be filled before opening (spec §3.1).
// starts_at is the opening of the first day and ends_at the closing of the
// last; the event runs every day in between with the same hours (§3.1.1).
model Event {
  id                    String          @id @default(uuid()) @db.Uuid
  organizerProfileId    String          @map("organizer_profile_id") @db.Uuid
  eventTypeId           String          @map("event_type_id") @db.Uuid
  name                  String
  slug                  String          @unique
  description           String?
  coverFileId           String?         @map("cover_file_id") @db.Uuid
  startsAt              DateTime?       @map("starts_at") @db.Timestamptz
  endsAt                DateTime?       @map("ends_at") @db.Timestamptz
  venueName             String?         @map("venue_name")
  addressLine           String?         @map("address_line")
  city                  String?
  province              String?
  latitude              Decimal?        @db.Decimal(9, 6)
  longitude             Decimal?        @db.Decimal(9, 6)
  vendorContactInfo     String?         @map("vendor_contact_info")
  status                EventStatus     @default(draft)
  moderationState       ModerationState @default(visible) @map("moderation_state")
  moderatedAt           DateTime?       @map("moderated_at") @db.Timestamptz
  moderatedById         String?         @map("moderated_by") @db.Uuid
  moderationReason      String?         @map("moderation_reason")
  applicationsOpen      Boolean         @default(false) @map("applications_open")
  applicationsCloseAt   DateTime?       @map("applications_close_at") @db.Timestamptz
  ingressInfo           String?         @map("ingress_info")
  // The cancellation and withdrawal policy (spec §3.7). Copied from the
  // organizer's most recent event when the draft is created; null on a first
  // event until the organizer saves it.
  policyText            String?         @map("policy_text")
  // The event the policy was copied from, for "Copied from your last event".
  policySourceEventId   String?         @map("policy_source_event_id") @db.Uuid
  paymentDeadlineHours  Int             @default(24) @map("payment_deadline_hours")
  defaultSlotPrice      Decimal?        @map("default_slot_price") @db.Decimal(10, 2)
  slotMode              SlotMode        @default(organizer_assigns) @map("slot_mode")
  vendorFloorPlanFileId String?         @map("vendor_floor_plan_file_id") @db.Uuid
  publicFloorPlanFileId String?         @map("public_floor_plan_file_id") @db.Uuid
  currency              String          @default("PHP") @db.Char(3)
  timezone              String          @default("Asia/Manila")
  openedToVendorsAt     DateTime?       @map("opened_to_vendors_at") @db.Timestamptz
  announcedAt           DateTime?       @map("announced_at") @db.Timestamptz
  completedAt           DateTime?       @map("completed_at") @db.Timestamptz
  canceledAt            DateTime?       @map("canceled_at") @db.Timestamptz
  cancelReason          String?         @map("cancel_reason")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  organizerProfile    OrganizerProfile           @relation(fields: [organizerProfileId], references: [id])
  eventType           EventType                  @relation(fields: [eventTypeId], references: [id])
  coverFile           File?                      @relation("EventCover", fields: [coverFileId], references: [id])
  moderatedBy         User?                      @relation("EventModerator", fields: [moderatedById], references: [id])
  policySource        Event?                     @relation("PolicySource", fields: [policySourceEventId], references: [id], onDelete: SetNull)
  policyCopies        Event[]                    @relation("PolicySource")
  categories          EventCategory[]
  documents           EventDocumentRequirement[]
  paymentMethods      EventPaymentMethod[]
  slots               Slot[]
  applications        Application[]
  assignments         SlotAssignment[]
  payments            Payment[]
  vendorFloorPlanFile File?                      @relation("VendorFloorPlan", fields: [vendorFloorPlanFileId], references: [id])
  publicFloorPlanFile File?                      @relation("PublicFloorPlan", fields: [publicFloorPlanFileId], references: [id])

  @@index([organizerProfileId])
  @@index([status, moderationState, startsAt])
  @@index([city, startsAt])
  @@map("events")
}

// The accepted product categories and the limit on similar vendors (spec §3.2).
model EventCategory {
  eventId    String @map("event_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  // A guide for the organizer when reviewing. Nobody is rejected automatically.
  maxVendors Int?   @map("max_vendors")

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@id([eventId, categoryId])
  @@map("event_categories")
}

// Permits and documents vendors upload when applying (spec §3.2). With a
// category, only vendors applying under it upload it.
model EventDocumentRequirement {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  description String?
  categoryId  String?  @map("category_id") @db.Uuid
  isRequired  Boolean  @default(true) @map("is_required")
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event     Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category  Category?             @relation(fields: [categoryId], references: [id])
  documents ApplicationDocument[]

  @@index([eventId])
  @@map("event_document_requirements")
}

enum PaymentChannel {
  gcash
  maya
  bank
  other

  @@map("payment_channel")
}

// Where vendors can send payment (spec §6.1). Turned off instead of deleted,
// because slot assignments keep a copy that points to it.
model EventPaymentMethod {
  id            String         @id @default(uuid()) @db.Uuid
  eventId       String         @map("event_id") @db.Uuid
  channel       PaymentChannel
  label         String
  accountName   String?        @map("account_name")
  accountNumber String?        @map("account_number")
  qrFileId      String?        @map("qr_file_id") @db.Uuid
  notes         String?
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @map("sort_order")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  qrFile File? @relation(fields: [qrFileId], references: [id])

  @@index([eventId])
  @@map("event_payment_methods")
}

// ─── Slots (data model §5.5) ───────────────────────────────────────────────

// How slots are filled (spec §3.4). The organizer assigns every slot either way.
enum SlotMode {
  organizer_assigns
  vendor_preference

  @@map("slot_mode")
}

// The event's slot list. No positions or drawing data. Status is worked out
// from the slot's active assignment (data model §7), not stored here.
model Slot {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  label     String
  section   String?
  // Null: the event's default price.
  price     Decimal?  @db.Decimal(10, 2)
  sizeLabel String?   @map("size_label")
  note      String?
  sortOrder Int       @map("sort_order")
  // Soft delete, because past assignments point to the slot.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  preferredBy Application[]
  assignments SlotAssignment[]

  @@index([eventId])
  @@map("slots")
}

// ─── Applications (data model §5.6) ────────────────────────────────────────

enum ApplicationStatus {
  submitted
  approved
  declined
  removed
  withdrawn

  @@map("application_status")
}

// A vendor's request to join an event (spec §3.3, §4.2). Reapplying creates a
// new row, so history is kept. Only one is active (submitted or approved) per
// vendor per event, enforced by a partial unique index (data model §6.2).
model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  eventId            String            @map("event_id") @db.Uuid
  vendorProfileId    String            @map("vendor_profile_id") @db.Uuid
  status             ApplicationStatus @default(submitted)
  vendorNote         String?           @map("vendor_note")
  // Holds nothing: several applications may prefer the same slot (spec §4.3).
  preferredSlotId    String?           @map("preferred_slot_id") @db.Uuid
  policyTextSnapshot String            @map("policy_text_snapshot")
  policyAcceptedAt   DateTime          @map("policy_accepted_at") @db.Timestamptz
  submittedAt        DateTime          @default(now()) @map("submitted_at") @db.Timestamptz
  decidedById        String?           @map("decided_by") @db.Uuid
  decidedAt          DateTime?         @map("decided_at") @db.Timestamptz
  decisionNote       String?           @map("decision_note")
  withdrawnAt        DateTime?         @map("withdrawn_at") @db.Timestamptz
  removedAt          DateTime?         @map("removed_at") @db.Timestamptz
  removedById        String?           @map("removed_by") @db.Uuid
  removalNote        String?           @map("removal_note")
  // Set on removal. False blocks new applications to this event.
  canReapply         Boolean?          @map("can_reapply")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  event         Event                 @relation(fields: [eventId], references: [id])
  vendorProfile VendorProfile         @relation(fields: [vendorProfileId], references: [id])
  preferredSlot Slot?                 @relation(fields: [preferredSlotId], references: [id])
  decidedBy     User?                 @relation("ApplicationDecider", fields: [decidedById], references: [id])
  removedBy     User?                 @relation("ApplicationRemover", fields: [removedById], references: [id])
  categories    ApplicationCategory[]
  documents     ApplicationDocument[]
  assignments   SlotAssignment[]

  @@index([eventId, status])
  @@index([vendorProfileId])
  @@map("applications")
}

// The categories the vendor sells under at this event. Each is one of the
// vendor's and one the event accepts.
model ApplicationCategory {
  applicationId String @map("application_id") @db.Uuid
  categoryId    String @map("category_id") @db.Uuid

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id])

  @@id([applicationId, categoryId])
  @@map("application_categories")
}

// Permits and documents uploaded with the application (private files).
model ApplicationDocument {
  id            String  @id @default(uuid()) @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  // Null for extra documents.
  requirementId String? @map("requirement_id") @db.Uuid
  fileId        String  @map("file_id") @db.Uuid

  application Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement EventDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  file        File                      @relation(fields: [fileId], references: [id])

  @@index([applicationId])
  @@index([fileId])
  @@map("application_documents")
}

// ─── Slot assignments and payments (data model §5.7) ───────────────────────

// assigned: payment not yet approved. reserved: payment approved. The rest
// are end states. Only assigned and reserved are active.
enum AssignmentStatus {
  assigned
  reserved
  released
  removed
  canceled

  @@map("assignment_status")
}

enum PaymentStatus {
  pending
  submitted
  approved
  rejected

  @@map("payment_status")
}

enum PaymentMethod {
  proof_upload
  cash
  other

  @@map("payment_method")
}

// One vendor's claim on one slot, from assignment until it ends (spec §5).
// At most one active assignment per slot, and one per vendor per event
// (partial unique indexes, data model §6.3, §6.4).
model SlotAssignment {
  id                          String           @id @default(uuid()) @db.Uuid
  slotId                      String           @map("slot_id") @db.Uuid
  eventId                     String           @map("event_id") @db.Uuid
  applicationId               String           @map("application_id") @db.Uuid
  vendorProfileId             String           @map("vendor_profile_id") @db.Uuid
  status                      AssignmentStatus @default(assigned)
  // Copied at assignment, so later price or payment changes don't move what
  // this vendor was told (spec §6.1).
  priceLocked                 Decimal          @map("price_locked") @db.Decimal(10, 2)
  paymentInstructionsSnapshot Json?            @map("payment_instructions_snapshot")
  assignedAt                  DateTime         @map("assigned_at") @db.Timestamptz
  assignedById                String           @map("assigned_by") @db.Uuid
  // Shown, not enforced (spec §6.4). Never after the event start (§6.7).
  deadlineAt                  DateTime         @map("deadline_at") @db.Timestamptz
  reservedAt                  DateTime?        @map("reserved_at") @db.Timestamptz
  endedAt                     DateTime?        @map("ended_at") @db.Timestamptz
  endedById                   String?          @map("ended_by") @db.Uuid
  endedReason                 String?          @map("ended_reason")
  createdAt                   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  slot          Slot          @relation(fields: [slotId], references: [id])
  event         Event         @relation(fields: [eventId], references: [id])
  application   Application   @relation(fields: [applicationId], references: [id])
  vendorProfile VendorProfile @relation(fields: [vendorProfileId], references: [id])
  assignedBy    User          @relation("SlotAssigner", fields: [assignedById], references: [id])
  endedBy       User?         @relation("AssignmentEnder", fields: [endedById], references: [id])
  payment       Payment?

  @@index([eventId, status])
  @@index([applicationId])
  @@map("slot_assignments")
}

// What is owed for one assignment, and its status (spec §6.7).
model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  slotAssignmentId    String        @unique @map("slot_assignment_id") @db.Uuid
  eventId             String        @map("event_id") @db.Uuid
  payerUserId         String        @map("payer_user_id") @db.Uuid
  payeeUserId         String        @map("payee_user_id") @db.Uuid
  amountDue           Decimal       @map("amount_due") @db.Decimal(10, 2)
  amountPaid          Decimal?      @map("amount_paid") @db.Decimal(10, 2)
  currency            String        @default("PHP") @db.Char(3)
  status              PaymentStatus @default(pending)
  method              PaymentMethod @default(proof_upload)
  decidedById         String?       @map("decided_by") @db.Uuid
  decidedAt           DateTime?     @map("decided_at") @db.Timestamptz
  decisionNote        String?       @map("decision_note")
  // Set when the vendor is removed or the event is canceled: read-only.
  archivedAt          DateTime?     @map("archived_at") @db.Timestamptz
  // Designed but unused in the MVP (revenue model §7).
  platformFeeAmount   Decimal?      @map("platform_fee_amount") @db.Decimal(10, 2)
  platformFeePayer    String?       @map("platform_fee_payer")
  processingFeeAmount Decimal?      @map("processing_fee_amount") @db.Decimal(10, 2)
  netPayoutAmount     Decimal?      @map("net_payout_amount") @db.Decimal(10, 2)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  slotAssignment SlotAssignment @relation(fields: [slotAssignmentId], references: [id])
  event          Event          @relation(fields: [eventId], references: [id])
  payer          User           @relation("PaymentPayer", fields: [payerUserId], references: [id])
  payee          User           @relation("PaymentPayee", fields: [payeeUserId], references: [id])
  decidedBy      User?          @relation("PaymentDecider", fields: [decidedById], references: [id])

  @@index([eventId, status])
  @@map("payments")
}

// ─── Email notifications (data model §5.9) ─────────────────────────────────

enum EmailStatus {
  queued
  sent
  failed

  @@map("email_status")
}

// Values are added as the features that send them are built.
enum NotificationType {
  email_verification
  email_change_confirmation
  password_reset
  organizer_approved
  organizer_rejected
  application_submitted
  application_withdrawn
  application_approved
  application_declined
  slot_assigned

  @@map("notification_type")
}

model EmailNotification {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String?          @map("user_id") @db.Uuid
  toEmail           String           @map("to_email") @db.Citext
  type              NotificationType
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id") @db.Uuid
  payload           Json
  status            EmailStatus      @default(queued)
  error             String?
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("email_notifications")
}

// ─── Audit log (data model §5.10) ──────────────────────────────────────────

// Append-only.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  changes     Json?
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}
