DATABASE_URL="postgresql://creavent:creavent@localhost:5432/creavent?schema=public"
PORT=3001

# Email (feature 1.2). Set RESEND_API_KEY, or EMAIL_DRIVER=log to print emails
# in the worker's log during local development. The worker refuses to start
# with neither.
RESEND_API_KEY=
EMAIL_FROM="Creavent <onboarding@resend.dev>"
# EMAIL_DRIVER=log

# Auth (feature 1.3). BETTER_AUTH_SECRET: a random string of 32+ characters,
# required in production (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# The web app's origin. Email links and Google's redirect use it.
WEB_URL=http://localhost:3000
# Google sign-in shows only when both are set. Authorized redirect URI in the
# Google Cloud console: <WEB_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
