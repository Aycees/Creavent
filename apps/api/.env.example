DATABASE_URL="postgresql://creavent:creavent@localhost:5432/creavent?schema=public"
PORT=3001

# Email (feature 1.2). Set RESEND_API_KEY, or EMAIL_DRIVER=log to print emails
# in the worker's log during local development. The worker refuses to start
# with neither.
RESEND_API_KEY=
EMAIL_FROM="Creavent <onboarding@resend.dev>"
# EMAIL_DRIVER=log

# Auth (feature 1.3). BETTER_AUTH_SECRET: a random string of 32+ characters,
# required in production (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# The web app's origin. Email links and Google's redirect use it.
WEB_URL=http://localhost:3100
# Google sign-in shows only when both are set. Authorized redirect URI in the
# Google Cloud console: <WEB_URL>/api/auth/callback/google
# Public pages (decision Q1): the same random string as in apps/web/.env, so
# the web app refreshes cached pages when they change.
REVALIDATE_SECRET=dev-revalidate-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 (feature 1.4). One public and one private bucket per
# environment. The private bucket needs a CORS rule that allows PUT from
# WEB_URL with the Content-Type header, because browsers upload to it directly.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
# The public bucket's custom domain, for example https://files.<domain>. Leave
# it empty to serve pictures through the API (/api/files/public/...). Don't use
# the r2.dev address: some networks block it, so pictures never load.
R2_PUBLIC_URL=
# The backups bucket (feature 5.5). Set it on staging and production, with a
# 30-day lifecycle rule. Unset locally: the nightly backup is off.
R2_BACKUPS_BUCKET=
# A separate R2 token for the backups bucket only (worker only, decision R13).
R2_BACKUPS_ACCESS_KEY_ID=
R2_BACKUPS_SECRET_ACCESS_KEY=

# Days payment records and documents are kept after an event (spec §6.7).
# PROOF_RETENTION_DAYS=90

# Seed data (local and staging only): the password every seeded account uses.
SEED_PASSWORD=creavent-dev-password
