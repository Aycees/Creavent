{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@creavent/web",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@creavent/api",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@creavent/api",
        "dev:worker"
      ]
    }
  ]
}
