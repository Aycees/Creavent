{
  "name": "creavent",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "pnpm --filter @creavent/api db:reset",
    "db:seed": "pnpm --filter @creavent/api db:seed",
    "generate:api": "turbo run generate:api"
  },
  "devDependencies": {
    "turbo": "^2.11.11"
  }
}
